  {
    "id": "circlemask",
    "name": "Circle Mask",
    "category": "Basic",
    "moduleName": "circlemask",
    "goal": "Generate a circular shape using texture coordinates and SphereMask.",
    "finalVisualResult": "A white circular mask on a black background.",
    "requiredNodes": ["TexCoord", "ScalarParameter", "SphereMask", "FinalColor"],
    "nodeRelationships": [
      "TexCoord provides UV coordinates to SphereMask input A.",
      "ScalarParameters define the Center, Radius, and Hardness.",
      "SphereMask outputs a circular gradient based on distance.",
      "FinalColor renders the output to the Viewport."
    ],
    "requiredParameters": [
      {
        "id": "radius",
        "name": "Radius",
        "type": "scalar",
        "min": 0.05,
        "max": 0.95,
        "default": 0.4,
        "description": "Circle radius."
      },
      {
        "id": "hardness",
        "name": "Hardness",
        "type": "scalar",
        "min": 0,
        "max": 1,
        "default": 0.9,
        "description": "Edge hardness."
      }
    ],
    "commonMistakes": [
      "Using incorrect coordinates for B (center). Should default to (0.5, 0.5).",
      "Setting radius larger than 0.5, causing clipping at bounds."
    ],
    "expectedBehavior": "Radius scales the circle size; Hardness sharpens or softens the edges.",
    "motionPreview": "Solid white circle on a black background.",
    "colorPreview": "Solid white circle on a black background.",
    "debugInformation": ["SphereMask output", "Radius", "Hardness"],
    "materialSettings": {
      "domain": "Surface",
      "blendMode": "Opaque"
    },
    "initialGraph": {
      "nodes": [
        { "id": "n_uv", "type": "customNode", "position": { "x": 50, "y": 150 }, "data": { "label": "TexCoord", "nodeType": "TexCoord", "inputs": [], "outputs": ["UV"], "values": {} } },
