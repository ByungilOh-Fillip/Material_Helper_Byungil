        { "id": "n_smask", "type": "customNode", "position": { "x": 320, "y": 180 }, "data": { "label": "SphereMask", "nodeType": "SphereMask", "inputs": ["A", "B", "Radius", "Hardness"], "outputs": ["Result"], "values": {} } },
        { "id": "n_out", "type": "customNode", "position": { "x": 550, "y": 200 }, "data": { "label": "Final Emissive", "nodeType": "FinalColor", "inputs": ["Color"], "outputs": [], "values": {} } }
      ],
      "edges": [
        { "id": "e1", "source": "n_uv", "sourceHandle": "UV", "target": "n_smask", "targetHandle": "A" },
        { "id": "e2", "source": "n_radius", "sourceHandle": "Float", "target": "n_smask", "targetHandle": "Radius" },
        { "id": "e3", "source": "n_hardness", "sourceHandle": "Float", "target": "n_smask", "targetHandle": "Hardness" },
        { "id": "e4", "source": "n_smask", "sourceHandle": "Result", "target": "n_out", "targetHandle": "Color" }
      ]
    }
  },
